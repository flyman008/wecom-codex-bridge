# 企业微信智能机器人（必填）
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_HEARTBEAT_MS=30000
WECOM_MAX_RECONNECT_ATTEMPTS=-1

# 安装策略（首次安装请运行 npm run setup，由安装人选择）
SERVICE_AUTOSTART=
ROUTING_MODE=
DEFAULT_AGENT=llm
MAX_ACTIVE_TASKS_PER_USER=3
STREAM_FLUSH_MS=800
STREAM_TIMEOUT_MS=330000
CODEX_ROUTE_CONFIDENCE=0.85
HEALTH_PORT=8787
ROUTER_AGENT_PROFILE_PATH=.runtime/router-agent.profile.json
ROUTER_AGENT_MEMORY_PATH=.runtime/router-memory.json

# OpenAI 兼容模型接口（可选；未配置时 /ask 不可用）
# 请使用允许接入自建应用的模型 API。不要把个人 Coding Plan 网关直接写死在代码里。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_SYSTEM_PROMPT=
LLM_TIMEOUT_MS=180000

# Codex CLI（可选；未配置工作目录时 /codex 不可用）
CODEX_COMMAND=codex
CODEX_MODEL=
# 仅在首选模型出现额度、配额或限流错误时使用；安装人可留空，表示不自动降级
CODEX_FALLBACK_MODEL=
# 留空表示继承安装人自己的 Codex 配置
CODEX_REASONING_EFFORT=
CODEX_SERVICE_TIER=
CODEX_WORKDIR=
# Windows 多个附加目录使用英文分号分隔，例如 C:\;D:\
CODEX_ADDITIONAL_DIRS=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=1800000
CODEX_EPHEMERAL=
CODEX_SESSION_PATH=.runtime/codex-sessions.json

# 文档附件暂存与限制
DOCUMENT_STAGING_DIR=.runtime/incoming
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_ATTACHMENT_TTL_MS=900000

# 本地 Agent HTTP 服务（可选；未配置时 /local 不可用）
LOCAL_AGENT_URL=
LOCAL_AGENT_TOKEN=
LOCAL_AGENT_TIMEOUT_MS=600000
ALLOW_REMOTE_LOCAL_AGENT=false
