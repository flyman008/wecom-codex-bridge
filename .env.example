# 企业微信智能机器人（必填）
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_HEARTBEAT_MS=30000
WECOM_MAX_RECONNECT_ATTEMPTS=-1

# 安装策略（首次安装请运行 npm run setup，由使用者选择）
SERVICE_AUTOSTART=
MAX_ACTIVE_TASKS_PER_USER=3
STREAM_FLUSH_MS=800
STREAM_TIMEOUT_MS=330000
HEALTH_PORT=8787
PERSONA_PROFILE_PATH=.runtime/persona-profile.json

# Codex CLI（必需；先安装并通过 codex login 登录）
CODEX_COMMAND=codex
CODEX_MODEL=
# 仅在首选模型出现额度、配额或限流错误时使用；使用者可留空，表示不自动降级
CODEX_FALLBACK_MODEL=
# 留空表示继承使用者自己的 Codex 配置
CODEX_REASONING_EFFORT=
CODEX_SERVICE_TIER=
CODEX_WORKDIR=
# Windows 多个附加目录使用英文分号分隔，例如 C:\;D:\
CODEX_ADDITIONAL_DIRS=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=1800000
CODEX_EPHEMERAL=
CODEX_SESSION_PATH=.runtime/codex-sessions.json

# 文档附件暂存与限制
DOCUMENT_STAGING_DIR=.runtime/incoming
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_ATTACHMENT_TTL_MS=900000
